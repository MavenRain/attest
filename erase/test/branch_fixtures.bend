import Base

def Fixture.branch_dependent() -> String:
  "mu Equal : (0 n : Nat) -> Prop with\n| refl : (0 n : Nat) -> Equal n\nmu Pack : Type 0 with\n| pack : (0 n : Nat) -> (h : Equal n) -> Pack\n\ndef Layout : (b : Pack) -> Type 0 := fun (b : Pack) => case b as value in Pack return Type 0 with | pack 0 n h => case (h : Equal n) as p in Equal k return Type 0 with | refl 0 j => prod ()\ndef keep : (x : Layout (pack 0 (refl 0))) -> Layout (pack 0 (refl 0)) := fun (x : Layout (pack 0 (refl 0))) => x\n"

def Fixture.branch_dependent_opaque() -> String:
  "mu Equal : (0 n : Nat) -> Prop with\n| refl : (0 n : Nat) -> Equal n\nmu Pack : Type 0 with\n| pack : (0 n : Nat) -> (h : Equal n) -> Pack\n\naxiom proof : (0 n : Nat) -> (0 h : Equal n) -> Equal n\ndef Layout : (b : Pack) -> Type 0 := fun (b : Pack) => case b as value in Pack return Type 0 with | pack 0 n h => case proof n h as p in Equal k return Type 0 with | refl 0 j => prod ()\ndef keep : (x : Layout (pack 0 (refl 0))) -> Layout (pack 0 (refl 0)) := fun (x : Layout (pack 0 (refl 0))) => x\n"

def Fixture.branch_nested() -> String:
  "mu Tone : Type 0 with\n| tone : Tone\nmu Mark : Type 0 with\n| mark : Mark\nmu Equal : (0 a : Nat) -> (0 b : Tone) -> (0 c : Mark) -> Prop with\n| refl : (0 a : Nat) -> (0 b : Tone) -> (0 c : Mark) -> Equal a b c\nmu Box : Type 0 with\n| box : (0 n : Tone) -> Box\nmu Cell : Type 0 with\n| cell : (0 m : Mark) -> Cell\n\ndef Layout : (0 outer : Nat) -> (a : Box) -> (b : Cell) -> Type 0 := fun (0 outer : Nat) (a : Box) (b : Cell) => case a as first in Box return Type 0 with | box 0 n => case b as second in Cell return Type 0 with | cell 0 m => case (refl outer n m : Equal outer n m) as p in Equal i j k return Type 0 with | refl 0 i 0 j 0 k => prod ()\ndef keep : (x : Layout 7 (box tone) (cell mark)) -> Layout 7 (box tone) (cell mark) := fun (x : Layout 7 (box tone) (cell mark)) => x\n"

def Fixture.branch_nested_opaque() -> String:
  "mu Tone : Type 0 with\n| tone : Tone\nmu Mark : Type 0 with\n| mark : Mark\nmu Equal : (0 a : Nat) -> (0 b : Tone) -> (0 c : Mark) -> Prop with\n| refl : (0 a : Nat) -> (0 b : Tone) -> (0 c : Mark) -> Equal a b c\nmu Box : Type 0 with\n| box : (0 n : Tone) -> Box\nmu Cell : Type 0 with\n| cell : (0 m : Mark) -> Cell\n\naxiom proof : (0 a : Nat) -> (0 b : Tone) -> (0 c : Mark) -> Equal a b c\ndef Layout : (0 outer : Nat) -> (a : Box) -> (b : Cell) -> Type 0 := fun (0 outer : Nat) (a : Box) (b : Cell) => case a as first in Box return Type 0 with | box 0 n => case b as second in Cell return Type 0 with | cell 0 m => case proof outer n m as p in Equal i j k return Type 0 with | refl 0 i 0 j 0 k => prod ()\ndef keep : (x : Layout 7 (box tone) (cell mark)) -> Layout 7 (box tone) (cell mark) := fun (x : Layout 7 (box tone) (cell mark)) => x\n"

# The branch constructor is not the head constructor of its family.
def Fixture.branch_multi_ctor() -> String:
  "mu Equal : (0 n : Nat) -> Prop with\n| refl : (0 n : Nat) -> Equal n\nmu Tag : Type 0 with\n| plain : (0 n : Nat) -> (0 m : Nat) -> Tag\n| proved : (0 n : Nat) -> (h : Equal n) -> Tag\n\ndef Layout : (t : Tag) -> Type 0 := fun (t : Tag) => case t as value in Tag return Type 0 with | plain 0 n 0 m => (case (refl m : Equal m) as q in Equal k return Type 0 with | refl 0 j => prod ()) | proved 0 n h => case (h : Equal n) as p in Equal k return Type 0 with | refl 0 j => prod ()\ndef keep : (x : Layout (proved 0 (refl 0))) -> Layout (proved 0 (refl 0)) := fun (x : Layout (proved 0 (refl 0))) => x\n"

def Fixture.branch_multi_ctor_opaque() -> String:
  "mu Equal : (0 n : Nat) -> Prop with\n| refl : (0 n : Nat) -> Equal n\nmu Tag : Type 0 with\n| plain : (0 n : Nat) -> (0 m : Nat) -> Tag\n| proved : (0 n : Nat) -> (h : Equal n) -> Tag\n\naxiom proof : (0 n : Nat) -> (0 h : Equal n) -> Equal n\ndef Layout : (t : Tag) -> Type 0 := fun (t : Tag) => case t as value in Tag return Type 0 with | plain 0 n 0 m => (case (refl m : Equal m) as q in Equal k return Type 0 with | refl 0 j => prod ()) | proved 0 n h => case proof n h as p in Equal k return Type 0 with | refl 0 j => prod ()\ndef keep : (x : Layout (proved 0 (refl 0))) -> Layout (proved 0 (refl 0)) := fun (x : Layout (proved 0 (refl 0))) => x\n"
