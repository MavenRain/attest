def Fixture.branch_parameter_dependent_opaque() -> String:
  "mu Equal : (0 A : Type 0) -> (0 a : A) -> Prop with\n| refl : (0 A : Type 0) -> (0 a : A) -> Equal A a\nmu Pack (0 A : Type 0) (0 a : A) : Type 0 with\n| empty : Pack A a\n| pack : (0 b : A) -> (h : Equal A b) -> Pack A a\n\naxiom proof : (0 A : Type 0) -> (0 b : A) -> (0 h : Equal A b) -> Equal A b\ndef Layout : (0 A : Type 0) -> (0 a : A) -> (b : Pack A a) -> Type 0 := fun (0 A : Type 0) => fun (0 a : A) => fun (b : Pack A a) => case b as value in Pack return Type 0 with | empty => prod () | pack 0 j h => case proof A j h as p in Equal T k return Type 0 with | refl 0 U 0 z => prod ()\ndef keep : (0 A : Type 0) -> (0 a : A) -> (b : Pack A a) -> (x : Layout A a b) -> Layout A a b := fun (0 A : Type 0) => fun (0 a : A) => fun (b : Pack A a) => fun (x : Layout A a b) => x\n"

