import Base

def Fixture.branch_parameter_annotated_opaque() -> String:
  "mu Equal : (0 n : Nat) -> Prop with\n| refl : (0 n : Nat) -> Equal n\nmu Pack (0 n : Nat) : Type 0 with\n| pack : (h : Equal n) -> Pack n\n\naxiom proof : (0 h : Equal 0) -> Equal 0\ndef Layout : (b : Pack 0) -> Type 0 := fun (b : Pack 0) => case (b : Pack 0) as value in Pack return Type 0 with | pack h => case proof h as p in Equal k return Type 0 with | refl 0 j => prod ()\ndef keep : (b : Pack 0) -> (x : Layout b) -> Layout b := fun (b : Pack 0) => fun (x : Layout b) => x\n"

