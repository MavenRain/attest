import Base
import ../lib/foundation.bend as F

type NumericCase is Data:
  NumericCase{a: String, b: String, na: Bool, nb: Bool, sum: String, product: String, difference: String, ordering: Cmp}

def signed(value: F.Bignum.t, negative: Bool) -> F.Bignum.t:
  match negative:
    case False{}:
      value
    case True{}:
      F.Bignum.negate(value)

def cmp_equal(a: Cmp, b: Cmp) -> Bool:
  match a b:
    case LT{} LT{}:
      True{}
    case EQ{} EQ{}:
      True{}
    case GT{} GT{}:
      True{}
    case LT{} EQ{}:
      False{}
    case LT{} GT{}:
      False{}
    case EQ{} LT{}:
      False{}
    case EQ{} GT{}:
      False{}
    case GT{} LT{}:
      False{}
    case GT{} EQ{}:
      False{}

def check_values(+a: F.Bignum.t, +b: F.Bignum.t, sum: String, product: String, difference: String, ordering: Cmp) -> Bool:
  Bool.and(String.eq(F.Bignum.to_string(F.Bignum.add(a, b)), sum),
    Bool.and(String.eq(F.Bignum.to_string(F.Bignum.mul(a, b)), product),
      Bool.and(String.eq(F.Bignum.to_string(F.Bignum.sub(a, b)), difference),
        cmp_equal(F.Bignum.compare(a, b), ordering))))

def check_parsed(a: Maybe<&2, F.Bignum.t>, b: Maybe<&2, F.Bignum.t>, na: Bool, nb: Bool, sum: String, product: String, difference: String, ordering: Cmp) -> Bool:
  match a b:
    case Some{x} Some{y}:
      check_values(signed(x, na), signed(y, nb), sum, product, difference, ordering)
    case None{} None{}:
      False{}
    case None{} Some{y}:
      False{}
    case Some{x} None{}:
      False{}

def check_case(row: NumericCase) -> Bool:
  match row:
    case NumericCase{a, b, na, nb, sum, product, difference, ordering}:
      check_parsed(F.Bignum.of_decimal(a), F.Bignum.of_decimal(b), na, nb, sum, product, difference, ordering)

def failures(rows: List<&2, NumericCase>) -> Nat:
  match rows:
    case Nil{}:
      0n
    case Con{row, tail}:
      (U32.to_nat(Bool.to_u32(Bool.not(check_case(row)))) + failures(tail) : Nat)

def finish(failed: Nat) -> IO(Unit):
  match failed:
    case 0n:
      IO.print("FOUNDATION numeric pass=90 fail=0")
    case 1n+p:
      IO.die(Unit, 1, "FOUNDATION numeric FAIL")

