def u32_failures(rows: List<&2, U32>) -> Nat:
  match rows:
    case Nil{}:
      0n
    case Con{+x, xs}:
      valid = F.Bignum.equal(F.Bignum.from_u32(x), F.Bignum.from_nat(U32.to_nat(x)))
      (U32.to_nat(Bool.to_u32(Bool.not(valid))) + u32_failures(xs) : Nat)

def main() -> IO(Unit):
  conversions = u32_failures([0, 1, 32767, 32768, 1073741823, 1073741824, 1073741825, 2147483648, 4294967295])
  square = String.eq(F.Bignum.to_string(F.Bignum.mul(F.Bignum.from_u32(4294967295), F.Bignum.from_u32(4294967295))), "18446744065119617025")
  finish(((failures(cases) + conversions : Nat) + U32.to_nat(Bool.to_u32(Bool.not(square))) : Nat))
