mu Choice (0 P : Type 0) (0 p : P) : Type 1 with
| empty : Choice P p
| choose : (0 A : Type 0) -> (0 b : P) -> (0 B : Type 0) -> Choice P p

mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

axiom sealed : (0 A : Type 0) -> (0 x : A) -> Equal A x
def Fn : Type 1 := (0 A : Type 0) -> (0 x : A) -> (case (choose (prod ()) x A : Choice A x) as choice in Choice return Type 1 with | choose 0 B 0 b 0 C => (0 y : C) -> Type 0 | empty => (y : A) -> Type 0)
def Alias : Type 1 := Fn
def Layout : Alias := fun (0 A : Type 0) (0 x : A) (0 y : A) => case sealed A y as p in Equal B z return Type 0 with | refl 0 C 0 w => prod ()
def keep : (x : Layout Nat 0 1) -> Layout Nat 0 1 := fun (x : Layout Nat 0 1) => x
