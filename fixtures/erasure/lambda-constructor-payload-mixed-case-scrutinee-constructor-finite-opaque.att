mu Payload : Type 0 with
| pair : (left : Nat) -> (right : Nat) -> Payload

mu Switch : Type 0 with
| empty : Switch
| pick : (n : Nat) -> Switch

mu IndexBox : Type 0 with
| zero : IndexBox
| value : (payload : Payload) -> (tail : Nat) -> IndexBox

mu Choice : (0 n : IndexBox) -> Type 1 with
| empty : Choice zero
| choose : (0 A : Type 0) -> (0 b : IndexBox) -> (0 B : Type 0) -> Choice b

mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n

def Zero : Nat := 0
def One : Nat := 1
axiom sealed : (0 n : Nat) -> Equal n
def Index : IndexBox := value (case (case (case (pick Zero : Switch) as switch in Switch return sum (Nat, Nat) with | empty => inj 0 of 2 One | pick n => inj 1 of 2 (let z : Nat := n in z)) as choice return Payload with | 0 (n : Nat) => pair One One | 1 (n : Nat) => pair (let z : Nat := n in z) (((fun (z : Nat) => z) : (z : Nat) -> Nat) One)) as payload in Payload return Payload with | pair left right => pair (let z : Nat := right in z) (((fun (z : Nat) => z) : (z : Nat) -> Nat) left)) (Zero : Nat)
def Pick : Choice Index := choose Nat (value (pair One Zero) Zero) Nat
def Fn : Type 1 := case (Pick : Choice (value (pair One Zero) Zero)) as choice in Choice k return Type 1 with | empty => (n : Nat) -> Type 0 | choose 0 A 0 b 0 B => (0 n : B) -> Type 0
def Alias : Type 1 := Fn
def Layout : Alias := fun (0 n : Nat) => case sealed n as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (x : Layout 0) -> Layout 0 := fun (x : Layout 0) => x
