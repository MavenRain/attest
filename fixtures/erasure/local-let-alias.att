mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

def Layout : Type 0 := let A : Type 0 := Nat in case (refl A 0 : Equal A 0) as p in Equal B y return Type 0 with | refl 0 C 0 z => prod ()
def keep : (x : Layout) -> Layout := fun (x : Layout) => x
