mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

def Layout : Type 0 := let p : Equal Nat 0 := refl Nat 0 in let T : (n : Nat) -> Type 0 := fun (n : Nat) => case p as q in Equal B y return Type 0 with | refl 0 C 0 z => Nat in case (refl (T 0) 0 : Equal (T 0) 0) as r in Equal E w return Type 0 with | refl 0 F 0 u => prod ()
def keep : (x : Layout) -> Layout := fun (x : Layout) => x
