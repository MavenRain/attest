mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

axiom sealed : (0 A : Type 0) -> (0 x : A) -> Equal A x
def Fn : Type 1 := (0 A : Type 0) -> (case (inj 1 of 2 A : sum (Type 0, Type 0)) as choice return Type 1 with | 0 (B : Type 0) => (n : B) -> Type 0 | 1 (B : Type 0) => (0 x : B) -> Type 0)
def Alias : Type 1 := Fn
def Layout : Alias := fun (0 A : Type 0) (0 x : A) => case sealed A x as p in Equal B y return Type 0 with | refl 0 C 0 z => prod ()
def keep : (x : Layout Nat 0) -> Layout Nat 0 := fun (x : Layout Nat 0) => x
