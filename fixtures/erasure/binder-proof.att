mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n

def Layout : Type 0 := case ((let q : Nat := 0 in case (refl q : Equal q) as r in Equal k return Equal k with | refl 0 j => refl j) : Equal 0) as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (x : Layout) -> Layout := fun (x : Layout) => x
