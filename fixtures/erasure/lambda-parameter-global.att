mu Choice (0 P : Type 0) (0 p : P) : Type 1 with
| empty : Choice P p
| choose : (0 A : Type 0) -> (0 b : P) -> (0 B : Type 0) -> Choice P p

mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n

def Pick : Choice Nat 0 := choose Nat 0 Nat
def Fn : Type 1 := case Pick as choice in Choice return Type 1 with | empty => (n : Nat) -> Type 0 | choose 0 A 0 b 0 B => (0 n : B) -> Type 0
def Alias : Type 1 := Fn
def Layout : Alias := fun (0 n : Nat) => case (refl n : Equal n) as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (x : Layout 0) -> Layout 0 := fun (x : Layout 0) => x
