mu Same : (0 A : Type 0) -> (0 value : sum (A, A)) -> Prop with
| same : (0 A : Type 0) -> (0 value : sum (A, A)) -> Same A value
def MakeInput : (0 N : Type 0) -> Type 1 := fun (0 N : Type 0) => (0 A : Type 0) -> sum (A, A)
def Input : Type 1 := (MakeInput Nat : Type 1)
axiom input : Input
axiom proof : (0 A : Type 0) -> (0 value : sum (A, A)) -> Same A value

def keep : (0 A : Type 0) -> Nat := fun (0 A : Type 0) => case (input A) as self return (let p : Same A self := proof A self in Nat) with | 0 (left : A) => 7 | 1 (right : A) => 8
