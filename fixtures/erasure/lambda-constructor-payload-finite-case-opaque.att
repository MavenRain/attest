mu IndexBox : Type 0 with
| zero : IndexBox
| value : (n : Nat) -> IndexBox

mu Choice : (0 n : IndexBox) -> Type 1 with
| empty : Choice zero
| choose : (0 A : Type 0) -> (0 b : IndexBox) -> (0 B : Type 0) -> Choice b

mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n

axiom sealed : (0 n : Nat) -> Equal n
def Zero : Nat := 0
def One : Nat := 1
def Index : IndexBox := value (case (inj 1 of 2 0 : sum (Nat, Nat)) as choice return Nat with | 0 (n : Nat) => One | 1 (n : Nat) => n)
def Pick : Choice Index := choose Nat (value 0) Nat
def Fn : Type 1 := case (Pick : Choice (value 0)) as choice in Choice k return Type 1 with | empty => (n : Nat) -> Type 0 | choose 0 A 0 b 0 B => (0 n : B) -> Type 0
def Alias : Type 1 := Fn
def Layout : Alias := fun (0 n : Nat) => case sealed n as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (x : Layout 0) -> Layout 0 := fun (x : Layout 0) => x
