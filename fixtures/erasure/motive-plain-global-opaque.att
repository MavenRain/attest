mu Same : (0 value : sum (Nat, Nat)) -> Prop with
| same : (0 value : sum (Nat, Nat)) -> Same value
axiom input : sum (Nat, Nat)
axiom proof : (0 value : sum (Nat, Nat)) -> Same value

def keep : Nat := case input as self return (let p : Same self := proof self in Nat) with | 0 (x : Nat) => 7 | 1 (y : Nat) => 8
