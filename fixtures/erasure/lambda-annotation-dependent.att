mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

def MakeFn : (0 A : Type 0) -> Type 1 := fun (0 A : Type 0) => (0 x : A) -> Type 0
def Fn : Type 1 := (0 A : Type 0) -> (MakeFn A : Type 1)
def Alias : Type 1 := Fn
def Layout : Alias := fun (0 A : Type 0) (0 x : A) => case (refl A x : Equal A x) as p in Equal B y return Type 0 with | refl 0 C 0 z => prod ()
def keep : (x : Layout Nat 0) -> Layout Nat 0 := fun (x : Layout Nat 0) => x
