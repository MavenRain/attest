mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n
mu Tag : Type 0 with
| plain : (0 n : Nat) -> (0 m : Nat) -> Tag
| proved : (0 n : Nat) -> (h : Equal n) -> Tag

axiom proof : (0 n : Nat) -> (0 h : Equal n) -> Equal n
def Layout : (t : Tag) -> Type 0 := fun (t : Tag) => case t as value in Tag return Type 0 with | plain 0 n 0 m => (case (refl m : Equal m) as q in Equal k return Type 0 with | refl 0 j => prod ()) | proved 0 n h => case proof n h as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (x : Layout (proved 0 (refl 0))) -> Layout (proved 0 (refl 0)) := fun (x : Layout (proved 0 (refl 0))) => x
