mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n
mu Pack (0 n : Nat) : Type 0 with
| pack : (h : Equal n) -> Pack n

axiom box : Pack 0
def Layout : Type 0 := case box as value in Pack return Type 0 with | pack h => case (h : Equal 0) as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (x : Layout) -> Layout := fun (x : Layout) => x
