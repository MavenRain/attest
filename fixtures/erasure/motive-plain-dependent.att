mu Same : (0 A : Type 0) -> (0 value : sum (A, A)) -> Prop with
| same : (0 A : Type 0) -> (0 value : sum (A, A)) -> Same A value

def keep : (0 A : Type 0) -> (v : sum (A, A)) -> Nat := fun (0 A : Type 0) => fun (v : sum (A, A)) => case v as self return (let p : Same A self := (same A self : Same A self) in Nat) with | 0 (x : A) => 7 | 1 (y : A) => 8
