mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

axiom proof : Equal Nat 0
def Layout : (0 m : Nat) -> Type 0 := fun (0 m : Nat) => let p : Equal Nat m := refl Nat m in case proof as r in Equal E w return Type 0 with | refl 0 F 0 u => prod ()
def keep : (x : Layout 0) -> Layout 0 := fun (x : Layout 0) => x
