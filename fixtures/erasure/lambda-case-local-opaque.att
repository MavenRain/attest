mu Equal : (0 A : Type 0) -> (0 x : A) -> Prop with
| refl : (0 A : Type 0) -> (0 x : A) -> Equal A x

axiom sealed : (0 A : Type 0) -> (0 y : A) -> Equal A y
def Layout : (0 A : Type 0) -> (0 x : A) -> Type 0 := fun (0 A : Type 0) (0 x : A) => let Choice : sum (Nat, Nat) := inj 1 of 2 0 in let Fn : Type 1 := case Choice as choice return Type 1 with | 0 (n : Nat) => (y : A) -> Type 0 | 1 (n : Nat) => (0 y : A) -> Type 0 in let Alias : Type 1 := Fn in let choose : Alias := fun (0 y : A) => case sealed A y as p in Equal B z return Type 0 with | refl 0 C 0 w => prod () in choose x
def keep : (x : Layout Nat 0) -> Layout Nat 0 := fun (x : Layout Nat 0) => x
