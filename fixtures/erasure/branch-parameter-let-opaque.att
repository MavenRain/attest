mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n
mu Pack (0 n : Nat) : Type 0 with
| pack : (h : Equal n) -> Pack n

axiom proof : (0 h : Equal 0) -> Equal 0
def Layout : (b : Pack 0) -> Type 0 := fun (b : Pack 0) => let c : Pack 0 := b in case c as value in Pack return Type 0 with | pack h => case proof h as p in Equal k return Type 0 with | refl 0 j => prod ()
def keep : (b : Pack 0) -> (x : Layout b) -> Layout b := fun (b : Pack 0) => fun (x : Layout b) => x
