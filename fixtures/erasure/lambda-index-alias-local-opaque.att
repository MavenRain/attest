mu Choice : (0 n : Nat) -> Type 1 with
| empty : Choice 0
| choose : (0 A : Type 0) -> (0 b : Nat) -> (0 B : Type 0) -> Choice b

mu Equal : (0 n : Nat) -> Prop with
| refl : (0 n : Nat) -> Equal n

axiom sealed : (0 n : Nat) -> Equal n
def Layout : Type 0 := let index : Nat := 0 in let Pick : Choice index := choose Nat 0 Nat in let Fn : Type 1 := case (Pick : Choice 0) as choice in Choice k return Type 1 with | empty => (n : Nat) -> Type 0 | choose 0 A 0 b 0 B => (0 n : B) -> Type 0 in let Alias : Type 1 := Fn in let choose : Alias := fun (0 n : Nat) => case sealed n as p in Equal k return Type 0 with | refl 0 j => prod () in choose 0
def keep : (x : Layout) -> Layout := fun (x : Layout) => x
